# ──────────────────────────────────────────────────────
# MALAI VIZHI — Environment Variable Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ──────────────────────────────────────────────────────

# Flask
# Set to "true" only during local development
FLASK_DEBUG=false

# Port Flask listens on (Render/Railway set this automatically)
PORT=5000

# CORS — comma-separated list of allowed frontend origins
# Leave empty to allow all origins (development only)
# Example: https://malai-vizhi.onrender.com,https://malai-vizhi.vercel.app
ALLOWED_ORIGINS=

# ──────────────────────────────────────────────────────
# React (Vite) — prefix all vars with VITE_
# These are baked in at build time, NOT secret
# ──────────────────────────────────────────────────────

# Only needed if React is deployed separately from Flask
# When Flask serves the React build, leave this empty (uses relative /api paths)
VITE_API_BASE=
